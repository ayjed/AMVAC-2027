# Payment Gateway (Sandbox disabled by default until merchant sign-off - D-07)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SANDBOX=true

# Admin Setup
ADMIN_DEFAULT_EMAIL="admin@amvac2027.org"
ADMIN_DEFAULT_PASSWORD="ChangeMe2027!Secure"
