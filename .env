APP_NAME="AMVAC 2027"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=amvac2027
DB_USER=root
DB_PASS=

# Transactional Email (Staging stubs to filesystem logs by default)
MAIL_DRIVER=log
MAIL_FROM_ADDRESS="secretariat@amvac2027.org"
