# ==============================================================================
# AMVAC 2027 — Production Environment Configuration
# ==============================================================================
# Copy this file to .env on your production server:
# cp .env.production.example .env
#
# IMPORTANT:
# - Set APP_DEBUG=false in production to prevent leaking sensitive debug details.
# - Replace DB_* values with your production MySQL / MariaDB database credentials.
# - Update APP_URL with your registered HTTPS domain (e.g., https://amvac2027.org).
# - Change ADMIN_DEFAULT_PASSWORD immediately after first login.
# ==============================================================================

APP_NAME="AMVAC 2027"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://amvac2027.org

# Database Credentials (from your cPanel / hosting database panel)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASS=your_strong_db_password

# Transactional Email (Use 'mail' or 'smtp' for live delivery, or 'log' for staging)
MAIL_DRIVER=log
MAIL_FROM_ADDRESS="secretariat@amvac2027.org"
MAIL_FROM_NAME="AMVAC 2027 Secretariat"

# Payment Gateway (Paystack — set live keys when merchant account sign-off is complete)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SANDBOX=true

# Initial Admin Credentials (used during database seeding; change on first login)
ADMIN_DEFAULT_EMAIL="admin@amvac2027.org"
ADMIN_DEFAULT_PASSWORD="ChangeMe2027!Secure"
